<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- 读取存储权限：MIUI 的 WallpaperManager 需要 READ_EXTERNAL_STORAGE，API 33+ 需要 READ_MEDIA_IMAGES -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- 所有文件访问权限：Android 11+ 用于绕过 MIUI/HyperOS 的 WallpaperManager 权限检查 -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WallpaperSwitcher">

        <!-- 主Activity：透明主题，singleTop启动模式 -->
        <!-- configChanges：防止壁纸变更触发的 config change 导致 Activity 销毁重建（MIUI/HyperOS 兼容） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|screenLayout|uiMode|keyboard|keyboardHidden|navigation|mcc|mnc|locale|smallestScreenSize|density|touchscreen|fontScale|fontWeightAdjustment"
            android:theme="@style/Theme.WallpaperSwitcher.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 长按图标弹出的快捷方式菜单 -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 设置Activity -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <!-- 允许磁贴服务长按启动 -->
            <intent-filter>
                <action android:name="com.chiya.workautowall.OPEN_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 快捷设置磁贴服务 -->
        <service
            android:name=".WallpaperTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_switch"
            android:label="@string/tile_label_switch"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <!-- 长按磁贴进入设置界面 -->
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

    </application>

</manifest>